# ==========================================
# BAHKANSO — Variables d'environnement
# ==========================================
# Copier ce fichier en .env.local et remplir les valeurs.
# Ne JAMAIS committer .env.local (il est dans .gitignore).

# URL du projet Supabase (local ou distant)
# Local : http://127.0.0.1:54321
# Production : https://dnyohupgyorjmuvbyhqk.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Clé publique (anon / publishable) Supabase
# Local : disponible via `supabase status` (ANON_KEY)
# Production : Settings → API → anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here
